# ==============================================================================
# CANALES DE NOTIFICACIÓN CON PLAN CONTINUO GRATUITO (RECOMENDADOS)
# ==============================================================================

# 1. Telegram Bot (100% Gratuito y Permanente - Sin límites de tiempo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord Webhook (100% Gratuito y Permanente)
DISCORD_WEBHOOK_URL=

# 3. CallMeBot WhatsApp (100% Gratuito para uso personal directo a WhatsApp)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ==============================================================================
# CANAL OPCIONAL DE PAGO TRAS PRUEBA
# ==============================================================================
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=
TWILIO_TO=

# ==============================================================================
# PARÁMETROS DEL MONITOR
# ==============================================================================
CHECK_INTERVAL_SECONDS=90
ALERT_COOLDOWN_HOURS=12.0
AMAZON_ASINS=B0CQV49Z5X,B0DFZ2M1R6
MAX_MSRP_PRICE_MXN=1600.0

# Porcentaje de margen/colchón sobre el MSRP oficial (default: 25%)
# Con 25%, una ETB de $49.99 USD (~$922 MXN) tiene tope de ~$1,153 MXN (cubre cómodamente precios de $1,100 MXN)
MSRP_CUSHION_PERCENT=25.0

# Exigir que el vendedor/remitente sea Amazon México oficial (ignora revendedores terceros aleatorios)
AMAZON_ONLY_OFFICIAL_SELLER=true

# Enviar mensaje de prueba al teléfono cada vez que el contenedor inicia (true/false)
SEND_STARTUP_TEST_ALERT=true
